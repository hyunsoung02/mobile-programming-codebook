<?xml version="1.0" encoding="utf-8"?>
<!-- [추가 코드] 외부 저작권 이미지·바이너리 복사 없이 실행할 수 있는 자체 XML 샘플이다.
     과제의 ImageView 이미지는 사진으로 한정되지 않는다. 두 뷰가 같은 이 리소스를 번갈아 표시한다.
     시험: startColor/endColor로 색을 바꾸고 size 높이와 레이아웃의 720dp를 함께 검토한다. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- 고유 크기는 320 x 720dp다. 화면상의 실제 크기는 ImageView의 layout 크기가 결정한다. -->
    <size android:width="320dp" android:height="720dp" />
    <!-- 위에서 아래로 파랑에서 노랑으로 변해, 스크롤 시 어느 부분인지 구분할 수 있다. -->
    <gradient
        android:angle="270"
        android:startColor="#1565C0"
        android:endColor="#FFF176" />
</shape>
