<?xml version="1.0" encoding="utf-8"?>
<!-- 출처: (Part2)Chapter01_안드로이드스튜디오와친숙해지기.pdf PDF p.107-108.
     [추가 코드] 과제의 연결 관계를 전체 XML로 작성하고 ID·문구·학습 주석을 보완했다.
     AndroidX ConstraintLayout 의존성이 있어야 이 루트와 app: 제약 속성을 사용할 수 있다.
     app은 res-auto 네임스페이스이며 android 네임스페이스로 대체하지 않는다. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 폭 0dp + 부모 양쪽 제약 = 가로 전체. 높이는 버튼 내용에 맞춘다.
         시험: 상단 높이를 고정하려면 layout_height만 dp 값으로 바꾼다. -->
    <Button
        android:id="@+id/top_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="위쪽 버튼"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 중앙은 폭·높이 모두 0dp로 남은 영역을 채운다.
         위는 상단 버튼의 아래, 아래는 하단 버튼의 위에 연결한다.
         흔한 오류: 높이를 wrap_content로 두면 중앙 공간 전체를 채우지 못한다. -->
    <Button
        android:id="@+id/center_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="가운데 버튼"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_button"
        app:layout_constraintBottom_toTopOf="@id/bottom_button" />

    <!-- 하단은 아래·양옆을 부모에 연결한다. ID 변경 시 중앙 버튼의 참조도 수정한다.
         match_parent 폭 대신 0dp와 양쪽 제약을 사용해야 제약에 따라 폭을 계산한다. -->
    <Button
        android:id="@+id/bottom_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="아래쪽 버튼"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
